FROM clux/muslrust:1.93.1-stable AS base
LABEL maintainer=kickhead13<ana.alexandru.gabriel@proton.me>
WORKDIR /build
ARG RUN_LINT
ARG SALT_ENCRYPTION_KEY
ARG SALT_ENCRYPTION_IV
ARG SCYLLA_CASSANDRA_PASSWORD
ARG RUN_UT
ARG OUTPUT=output

FROM base AS bare-repo
COPY --link --from=bare-repo . .
COPY --link Cargo* .

FROM bare-repo AS requirements
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    cargo build --release --target x86_64-unknown-linux-musl

FROM bare-repo AS ut-requirements
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    cargo test

FROM requirements AS workspace
COPY --link src/ src/
COPY --link Cargo* .
RUN touch src/main.rs

FROM ut-requirements AS ut-workspace
COPY --link src/ src/
COPY --link Cargo* .
RUN touch src/main.rs

FROM workspace AS linter-run
RUN rustup component add clippy
RUN --mount=type=cache,target=/usr/local/cargo/registry \
   cargo clippy --release --target x86_64-unknown-linux-musl \
   -- -D warnings

FROM scratch AS linter
ARG OUTPUT=output
COPY --from=linter-run /build/${OUTPUT}/ .

FROM ut-workspace AS ut-run
RUN --mount=type=cache,target=/usr/local/cargo/registry \
   cargo test

FROM scratch AS ut
ARG OUTPUT=output
COPY --from=ut-run /build/${OUTPUT}/ .

FROM workspace AS builder
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    cargo build --release --target x86_64-unknown-linux-musl

FROM scratch AS runtime
COPY --link --from=builder /build/target/x86_64-unknown-linux-musl/release/api .
CMD ["/api"]
